{
  "components": {
    "schemas": {
      "BoardColumns": {
        "description": "The four columns in board order, each with its tasks ordered by position.",
        "properties": {
          "done": {
            "items": {
              "$ref": "#/components/schemas/TaskOut"
            },
            "title": "Done",
            "type": "array"
          },
          "in_progress": {
            "items": {
              "$ref": "#/components/schemas/TaskOut"
            },
            "title": "In Progress",
            "type": "array"
          },
          "in_review": {
            "items": {
              "$ref": "#/components/schemas/TaskOut"
            },
            "title": "In Review",
            "type": "array"
          },
          "todo": {
            "items": {
              "$ref": "#/components/schemas/TaskOut"
            },
            "title": "Todo",
            "type": "array"
          }
        },
        "required": [
          "todo",
          "in_progress",
          "in_review",
          "done"
        ],
        "title": "BoardColumns",
        "type": "object"
      },
      "BoardOut": {
        "description": "A project board.",
        "properties": {
          "columns": {
            "$ref": "#/components/schemas/BoardColumns"
          },
          "project": {
            "$ref": "#/components/schemas/ProjectOut"
          }
        },
        "required": [
          "project",
          "columns"
        ],
        "title": "BoardOut",
        "type": "object"
      },
      "Column": {
        "description": "The four fixed board columns, in board order (FR-009).",
        "enum": [
          "todo",
          "in_progress",
          "in_review",
          "done"
        ],
        "title": "Column",
        "type": "string"
      },
      "ColumnCounts": {
        "description": "Number of tasks in each of the four columns.",
        "properties": {
          "done": {
            "title": "Done",
            "type": "integer"
          },
          "in_progress": {
            "title": "In Progress",
            "type": "integer"
          },
          "in_review": {
            "title": "In Review",
            "type": "integer"
          },
          "todo": {
            "title": "Todo",
            "type": "integer"
          }
        },
        "required": [
          "todo",
          "in_progress",
          "in_review",
          "done"
        ],
        "title": "ColumnCounts",
        "type": "object"
      },
      "CommentCreate": {
        "additionalProperties": false,
        "description": "Add a comment; the author is always the selected user, never taken from the body (FR-017).",
        "properties": {
          "body": {
            "title": "Body",
            "type": "string"
          }
        },
        "required": [
          "body"
        ],
        "title": "CommentCreate",
        "type": "object"
      },
      "CommentOut": {
        "description": "A comment as shown in the task details.",
        "properties": {
          "author": {
            "$ref": "#/components/schemas/UserOut"
          },
          "body": {
            "title": "Body",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "edited_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Edited At"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "task_id": {
            "title": "Task Id",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "task_id",
          "author",
          "body",
          "created_at",
          "edited_at"
        ],
        "title": "CommentOut",
        "type": "object"
      },
      "CommentUpdate": {
        "additionalProperties": false,
        "description": "Replace a comment's text (author only, FR-019).",
        "properties": {
          "body": {
            "title": "Body",
            "type": "string"
          }
        },
        "required": [
          "body"
        ],
        "title": "CommentUpdate",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "MoveRequest": {
        "additionalProperties": false,
        "description": "Move a task to a column; `position` is the target index, omitted means the bottom.",
        "properties": {
          "column": {
            "$ref": "#/components/schemas/Column"
          },
          "position": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Position"
          }
        },
        "required": [
          "column"
        ],
        "title": "MoveRequest",
        "type": "object"
      },
      "NotificationList": {
        "description": "The panel contents: newest first, plus the unread count for the bell badge.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/NotificationOut"
            },
            "title": "Items",
            "type": "array"
          },
          "unread_count": {
            "title": "Unread Count",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "unread_count"
        ],
        "title": "NotificationList",
        "type": "object"
      },
      "NotificationOut": {
        "description": "A notification as shown in the panel.",
        "properties": {
          "actor": {
            "$ref": "#/components/schemas/UserOut"
          },
          "comment_preview": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Comment Preview"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "project": {
            "$ref": "#/components/schemas/ProjectRef"
          },
          "read": {
            "title": "Read",
            "type": "boolean"
          },
          "task_id": {
            "title": "Task Id",
            "type": "integer"
          },
          "task_title": {
            "title": "Task Title",
            "type": "string"
          },
          "to_column": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "To Column"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "id",
          "type",
          "actor",
          "project",
          "task_id",
          "task_title",
          "to_column",
          "comment_preview",
          "created_at",
          "read"
        ],
        "title": "NotificationOut",
        "type": "object"
      },
      "ProjectCreate": {
        "additionalProperties": false,
        "description": "Create a project; its board always has the four fixed columns (FR-007).",
        "properties": {
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "ProjectCreate",
        "type": "object"
      },
      "ProjectOut": {
        "description": "A project as shown in lists and on the board header.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "created_at"
        ],
        "title": "ProjectOut",
        "type": "object"
      },
      "ProjectRef": {
        "description": "The project a notification belongs to.",
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "title": "ProjectRef",
        "type": "object"
      },
      "ProjectSummary": {
        "description": "A project with per-column counts and how many tasks are assigned to the selected user.",
        "properties": {
          "assigned_to_me": {
            "title": "Assigned To Me",
            "type": "integer"
          },
          "counts": {
            "$ref": "#/components/schemas/ColumnCounts"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "created_at",
          "counts",
          "assigned_to_me"
        ],
        "title": "ProjectSummary",
        "type": "object"
      },
      "TaskCreate": {
        "additionalProperties": false,
        "description": "Create a task in a project; it starts at the bottom of To Do (FR-010).",
        "properties": {
          "assignee_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Assignee Id"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "title"
        ],
        "title": "TaskCreate",
        "type": "object"
      },
      "TaskOut": {
        "description": "A task as shown on cards and in the task details.",
        "properties": {
          "assignee": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/UserOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "column": {
            "$ref": "#/components/schemas/Column"
          },
          "comment_count": {
            "title": "Comment Count",
            "type": "integer"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "position": {
            "title": "Position",
            "type": "integer"
          },
          "project_id": {
            "title": "Project Id",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "project_id",
          "title",
          "description",
          "column",
          "position",
          "assignee",
          "created_at",
          "updated_at",
          "comment_count"
        ],
        "title": "TaskOut",
        "type": "object"
      },
      "TaskUpdate": {
        "additionalProperties": false,
        "description": "Change any of title, description and assignee; `assignee_id: null` clears it (FR-011, FR-012).",
        "properties": {
          "assignee_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Assignee Id"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          }
        },
        "title": "TaskUpdate",
        "type": "object"
      },
      "UnreadCount": {
        "description": "Result of marking everything read.",
        "properties": {
          "unread_count": {
            "title": "Unread Count",
            "type": "integer"
          }
        },
        "required": [
          "unread_count"
        ],
        "title": "UnreadCount",
        "type": "object"
      },
      "UserOut": {
        "description": "A predefined user as shown in the UI.",
        "properties": {
          "avatar_color": {
            "title": "Avatar Color",
            "type": "string"
          },
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "initials": {
            "title": "Initials",
            "type": "string"
          },
          "role": {
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "id",
          "display_name",
          "role",
          "initials",
          "avatar_color"
        ],
        "title": "UserOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Taskify API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/comments/{comment_id}": {
      "delete": {
        "description": "Delete your own comment for everyone; anyone else gets 403.",
        "operationId": "delete_comment",
        "parameters": [
          {
            "in": "path",
            "name": "comment_id",
            "required": true,
            "schema": {
              "title": "Comment Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Delete Comment",
        "tags": [
          "comments"
        ]
      },
      "patch": {
        "description": "Edit your own comment; anyone else gets 403.",
        "operationId": "edit_comment",
        "parameters": [
          {
            "in": "path",
            "name": "comment_id",
            "required": true,
            "schema": {
              "title": "Comment Id",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CommentUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommentOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Edit Comment",
        "tags": [
          "comments"
        ]
      }
    },
    "/api/v1/health": {
      "get": {
        "description": "Report that the app is up and the database is reachable.",
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/metrics": {
      "get": {
        "description": "Return in-process counters as JSON.",
        "operationId": "get_metrics",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Metrics",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/notifications": {
      "get": {
        "description": "List your notifications, newest first, with the unread count.",
        "operationId": "list_notifications",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationList"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Notifications",
        "tags": [
          "notifications"
        ]
      }
    },
    "/api/v1/notifications/read-all": {
      "post": {
        "description": "Mark all of your notifications read.",
        "operationId": "read_all",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnreadCount"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Read All",
        "tags": [
          "notifications"
        ]
      }
    },
    "/api/v1/notifications/{notification_id}/read": {
      "post": {
        "description": "Mark one notification read. Someone else's notification returns 404.",
        "operationId": "read_one",
        "parameters": [
          {
            "in": "path",
            "name": "notification_id",
            "required": true,
            "schema": {
              "title": "Notification Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Read One",
        "tags": [
          "notifications"
        ]
      }
    },
    "/api/v1/projects": {
      "get": {
        "description": "List all projects with per-column task counts and how many tasks are assigned to you.",
        "operationId": "list_projects",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ProjectSummary"
                  },
                  "title": "Response List Projects",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Projects",
        "tags": [
          "projects"
        ]
      },
      "post": {
        "description": "Create a project. A name already used (ignoring letter case) returns 409.",
        "operationId": "create_project",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProjectCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Project",
        "tags": [
          "projects"
        ]
      }
    },
    "/api/v1/projects/{project_id}": {
      "get": {
        "description": "Return one project.",
        "operationId": "get_project",
        "parameters": [
          {
            "in": "path",
            "name": "project_id",
            "required": true,
            "schema": {
              "title": "Project Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Project",
        "tags": [
          "projects"
        ]
      }
    },
    "/api/v1/projects/{project_id}/board": {
      "get": {
        "description": "Return the project's board: four fixed columns, each ordered by position.",
        "operationId": "get_board",
        "parameters": [
          {
            "in": "path",
            "name": "project_id",
            "required": true,
            "schema": {
              "title": "Project Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BoardOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Board",
        "tags": [
          "projects"
        ]
      }
    },
    "/api/v1/projects/{project_id}/tasks": {
      "post": {
        "description": "Create a task at the bottom of To Do, optionally assigned to one of the five users.",
        "operationId": "create_task",
        "parameters": [
          {
            "in": "path",
            "name": "project_id",
